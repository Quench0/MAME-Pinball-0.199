<?xml version="1.0"?>
<!-- Pinball Machine, Stern ~ Hot hand -->
<!-- [Quench] November 2016 -->


<!-- Other than the Spinner, any state="9" items are used for object alignment only and are not displayed -->

<mamelayout version="2">

	<element name="Title"><text string="HOT HAND"><color red="1.00" green="1.00" blue="0.00" /></text></element>



	<element name="Ace">  <text string="ACE">  <color red="1.00" green="1.00" blue="1.00" /></text></element>
