	<element name="Text_Switch">   <text string="Switch Matrix"><color red="0.0" green="1.0" blue="1.0" /></text></element>
	<element name="Text_Multiball"><text string="Some Multi-ball games require balls on all Outhole switches to complete startup"><color red="0.0" green="1.0" blue="0.0" /></text></element>



