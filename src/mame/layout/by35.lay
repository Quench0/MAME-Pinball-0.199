	<element name="Title_Bally">   <text string="Bally"><color red="0.25" green="0.50" blue="1.00" /></text></element>

	<element name="Text_Playfield"><text string="See Playboy and Supersonic for mockup Playfield layouts"><color red="1.0" green="0.0" blue="1.0" /></text></element>
