<?xml version="1.0"?>
<!-- Pinball Machine, Bally ~ Template -35 MPU board -->

<!-- 2014-07-29: Initial version.  [Robbbert] -->
<!-- 2015-August: Added Lamp states, Solenoid states, Switch Matrix and a kit of playfield objects.  [Quench] -->


<!-- Other than the Spinner, any state="9" items are used for object alignment only and are not displayed -->

